[Unit]
Description=HestiaPi kiosk (matchbox + Chromium)
After=systemd-user-sessions.service systemd-logind.service
# We don't want to start this service after mosquitto or openhab, as we want
# this to show the loading screen early in the boot process, before those
# services are started.
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=x11
# Make sure the xorg config points to the correct device...
ExecStartPre=+/usr/local/sbin/set-kiosk-framebuffer
# The loader waits for openHAB and the retained MQTT values itself, so
# we don't want to block X from starting here.
ExecStart=/usr/bin/startx /usr/local/oneui/kiosk-xinitrc -- :0 vt1 -nocursor
# This LCD keeps the last frame in its own memory after X exits or the board
# powers off.  Wipe the framebuffer to black once all X clients are gone.
ExecStopPost=-+/bin/sh -c 'dev=$$(readlink /dev/fb-lcd); stride=$$(cat /sys/class/graphics/$$dev/stride); rows=$$(cut -d, -f2 /sys/class/graphics/$$dev/virtual_size); [ -n "$$stride" ] && [ -n "$$rows" ] && exec dd if=/dev/zero of=/dev/$$dev bs="$$stride" count="$$rows" status=none'
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
