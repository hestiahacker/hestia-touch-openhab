[Unit]
Description=HestiaPi kiosk (matchbox + Chromium)
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=x11
# Make sure the xorg config points to the correct device...
ExecStartPre=+/usr/local/sbin/set-kiosk-framebuffer
# ...before starting X
ExecStart=/usr/bin/startx /usr/local/oneui/kiosk-xinitrc -- :0 vt1
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
